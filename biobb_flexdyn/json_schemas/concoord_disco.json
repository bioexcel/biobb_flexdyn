{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://bioexcel.eu/biobb_flexdyn/json_schemas/1.0/concoord_disco",
    "name": "biobb_flexdyn ConcoordDisco",
    "title": "Wrapper of the Disco tool from the Concoord package.",
    "description": "Structure generation based on a set of geometric constraints extracted with the Concoord Dist tool.",
    "type": "object",
    "info": {
        "wrapped_software": {
            "name": "Concoord",
            "version": ">=2.1.2",
            "license": "other"
        },
        "ontology": {
            "name": "EDAM",
            "schema": "http://edamontology.org/EDAM.owl"
        }
    },
    "required": [
        "input_pdb_path",
        "input_dat_path",
        "output_traj_path",
        "output_rmsd_path",
        "output_bfactor_path"
    ],
    "properties": {
        "input_pdb_path": {
            "type": "string",
            "description": "Input structure file in PDB format",
            "filetype": "input",
            "sample": "https://github.com/bioexcel/biobb_flexdyn/raw/master/biobb_flexdyn/test/data/flexdyn/structure.pdb",
            "enum": [
                ".*\\.pdb$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.pdb$",
                    "description": "Input structure file in PDB format",
                    "edam": "format_1476"
                }
            ]
        },
        "input_dat_path": {
            "type": "string",
            "description": "Input dat with structure interpretation and bond definitions",
            "filetype": "input",
            "sample": "https://github.com/bioexcel/biobb_flexdyn/raw/master/biobb_flexdyn/test/data/flexdyn/dist.dat",
            "enum": [
                ".*\\.dat$",
                ".*\\.txt$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.dat$",
                    "description": "Input dat with structure interpretation and bond definitions",
                    "edam": "format_1637"
                },
                {
                    "extension": ".*\\.txt$",
                    "description": "Input dat with structure interpretation and bond definitions",
                    "edam": "format_2330"
                }
            ]
        },
        "output_traj_path": {
            "type": "string",
            "description": "Output trajectory file",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_flexdyn/raw/master/biobb_flexdyn/test/reference/flexdyn/disco_trj.pdb",
            "enum": [
                ".*\\.pdb$",
                ".*\\.xtc$",
                ".*\\.gro$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.pdb$",
                    "description": "Output trajectory file",
                    "edam": "format_1476"
                },
                {
                    "extension": ".*\\.xtc$",
                    "description": "Output trajectory file",
                    "edam": "format_3875"
                },
                {
                    "extension": ".*\\.gro$",
                    "description": "Output trajectory file",
                    "edam": "format_2033"
                }
            ]
        },
        "output_rmsd_path": {
            "type": "string",
            "description": "Output rmsd file",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_flexdyn/raw/master/biobb_flexdyn/test/reference/flexdyn/disco_rmsd.dat",
            "enum": [
                ".*\\.dat$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.dat$",
                    "description": "Output rmsd file",
                    "edam": "format_1637"
                }
            ]
        },
        "output_bfactor_path": {
            "type": "string",
            "description": "Output B-factor file",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_flexdyn/raw/master/biobb_flexdyn/test/reference/flexdyn/disco_bfactor.pdb",
            "enum": [
                ".*\\.pdb$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.pdb$",
                    "description": "Output B-factor file",
                    "edam": "format_1476"
                }
            ]
        },
        "properties": {
            "type": "object",
            "properties": {
                "binary_path": {
                    "type": "string",
                    "default": "disco",
                    "wf_prop": false,
                    "description": "Concoord disco binary path to be used."
                },
                "vdw": {
                    "type": "integer",
                    "default": 1,
                    "wf_prop": false,
                    "description": "Select a set of Van der Waals parameters. ",
                    "enum": [
                        1,
                        2,
                        3,
                        4,
                        5,
                        6
                    ],
                    "property_formats": [
                        {
                            "name": 1,
                            "description": "OPLS-UA -united atoms- parameters"
                        },
                        {
                            "name": 2,
                            "description": "OPLS-AA -all atoms- parameters"
                        },
                        {
                            "name": 3,
                            "description": "PROLSQ repel parameters"
                        },
                        {
                            "name": 4,
                            "description": "Yamber2 parameters"
                        },
                        {
                            "name": 5,
                            "description": "Li et al. parameters"
                        },
                        {
                            "name": 6,
                            "description": "OPLS-X parameters -recommended for NMR structure determination-"
                        }
                    ]
                },
                "concoord_lib_path": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Path to Concoord library files. If not specified will look for CONCOORDLIB conda environment variable."
                },
                "num_structs": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Number of structures to be generated. If not set, CONCOORD uses 500."
                },
                "num_iterations": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Maximum number of iterations per structure. If not set, CONCOORD uses 2500."
                },
                "chirality_check": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Chirality check. If not set, CONCOORD uses 2. ",
                    "enum": [
                        0,
                        1,
                        2
                    ],
                    "property_formats": [
                        {
                            "name": 0,
                            "description": "no chirality checks"
                        },
                        {
                            "name": 1,
                            "description": "only check afterwards"
                        },
                        {
                            "name": 2,
                            "description": "check on the fly"
                        }
                    ]
                },
                "bs": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Number of rounds of triangular bound smoothing (default 0), (if >= 6, tetragonal BS is activated). If not set, CONCOORD uses 0."
                },
                "nofit": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Do not fit generated structures to reference"
                },
                "seed": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Initial random seed. If not set, CONCOORD uses 741265."
                },
                "violation": {
                    "type": "number",
                    "default": null,
                    "wf_prop": false,
                    "description": "Maximal acceptable sum of violations (nm). If not set, CONCOORD uses 1.0."
                },
                "convergence": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Consider convergence failed after this number of non-productive iterations. If not set, CONCOORD uses 500."
                },
                "trials": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Maximum number of trials per run. If not set, CONCOORD uses 25."
                },
                "damp": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Damping factor for distance corrections. If not set, CONCOORD uses 1. ",
                    "enum": [
                        1,
                        2
                    ],
                    "property_formats": [
                        {
                            "name": 1,
                            "description": "default"
                        },
                        {
                            "name": 2,
                            "description": "for cases with convergence problems"
                        }
                    ]
                },
                "dyn": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Number of rounds to dynamically set tolerances. If not set, CONCOORD uses 0."
                },
                "bump": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Do extra bump check"
                },
                "pairlist_freq": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Pairlist update frequency in steps (only valid together with bump). If not set, CONCOORD uses 10."
                },
                "cutoff": {
                    "type": "number",
                    "default": null,
                    "wf_prop": false,
                    "description": "Cut-off radius for pairlist (nm) (only valid together with bump). If not set, CONCOORD uses 0.5."
                },
                "ref": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Use input coordinates instead of random starting coordinates"
                },
                "scale": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Pre-scale coordinates with this factor. If not set, CONCOORD uses 1."
                },
                "remove_tmp": {
                    "type": "boolean",
                    "default": true,
                    "wf_prop": true,
                    "description": "Remove temporal files."
                },
                "restart": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": true,
                    "description": "Do not execute if output files exist."
                },
                "sandbox_path": {
                    "type": "string",
                    "default": "./",
                    "wf_prop": true,
                    "description": "Parent path to the sandbox directory."
                },
                "container_path": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Path to the binary executable of your container."
                },
                "container_image": {
                    "type": "string",
                    "default": "cmip/cmip:latest",
                    "wf_prop": false,
                    "description": "Container Image identifier."
                },
                "container_volume_path": {
                    "type": "string",
                    "default": "/data",
                    "wf_prop": false,
                    "description": "Path to an internal directory in the container."
                },
                "container_working_dir": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Path to the internal CWD in the container."
                },
                "container_user_id": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "User number id to be mapped inside the container."
                },
                "container_shell_path": {
                    "type": "string",
                    "default": "/bin/bash",
                    "wf_prop": false,
                    "description": "Path to the binary executable of the container shell."
                }
            }
        }
    },
    "additionalProperties": false
}